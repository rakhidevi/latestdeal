# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Laravel Production API
LARAVEL_API_URL=https://latestdeal.in/api/v1
LARAVEL_API_KEY=your_secret_bearer_token_here

# WebSocket Connection (for Instant Scraping)
LARAVEL_WEBSOCKET_URL=wss://latestdeal.in/app/your-app-key

# Amazon Creators API (Amazon India). Keep real credentials only in worker/.env.
# Generate these in Amazon Associates Central after Creators API access is approved.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_CREATORS_MARKETPLACE=www.amazon.in
# Optional override if Amazon assigns a different OAuth token endpoint.
# AMAZON_CREATORS_TOKEN_ENDPOINT=https://api.amazon.co.uk/auth/o2/token
